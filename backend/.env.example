# Azure SQL connection (set these as App Service application settings in production)
DB_HOST=your-server.database.windows.net
DB_PORT=1433
DB_USER=your-sql-user
DB_PASS=your-sql-password
DB_NAME=your-database

# Public URL the app is served from. Used to build invitation links and the
# Google OAuth redirect URI. Can also be set in the UI (Settings → Integrations).
APP_BASE_URL=https://your-app.azurewebsites.net

# First-run only: creates/repairs an admin account with a password so someone can
# sign in and connect Google. Remove both once you're in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
