<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows App Service (iisnode) only. Ignored on Linux App Service.
  Routes every request to the Node process, which serves the SPA and /api.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="backend/dist/main.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="OrigamiNode">
          <match url=".*" />
          <action type="Rewrite" url="backend/dist/main.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode nodeProcessCommandLine="node" />
  </system.webServer>
</configuration>
